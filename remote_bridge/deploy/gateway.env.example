# /etc/alejandro-gateway/gateway.env  (root:alejandro-gw, mode 0640)
# install_gateway.sh generates the two tokens if this file does not exist.

BRIDGE_DATA_DIR=/var/lib/alejandro-gateway

# Internal API credentials (>= 32 chars, must differ).
# MAXBOT: held by the MaxBot plugin (events, approvals, Alexa answers).
# AGENT:  given to the model's tool CLI (list devices, request calls; never approve).
BRIDGE_MAXBOT_TOKEN=
BRIDGE_AGENT_TOKEN=

# Alexa (leave ALEXA_SKILL_ID empty to keep /alexa/v1 switched off)
ALEXA_SKILL_ID=
# Comma-separated Amazon user ids allowed to talk to the assistant.
ALEXA_ALLOWED_USER_IDS=
# Seconds to wait for MaxBot before saying "sigo trabajando" (Alexa gives ~8 s total).
ALEXA_BUDGET_SECONDS=6.0
ALEXA_PROGRESSIVE=1
# 1 = log the full Amazon user id of unknown callers (to enrol yourself), then set back to 0.
ALEXA_ENROLL=0

ASSISTANT_NAME=Alejandro
BRIDGE_LOG_LEVEL=INFO
